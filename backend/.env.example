# ─── ShodhFund Backend Environment ───
# Copy to .env and fill in values

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host.neon.tech/shodhfund?sslmode=require

# JWT Auth
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_EXPIRES_IN=24h

# Gemini AI (optional — demo OCR works without it)
GEMINI_API_KEY=

# Cloudflare R2 / S3 File Storage (optional — local uploads/ used as fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shodhfund-uploads
R2_ENDPOINT=
R2_PUBLIC_URL=

# Server
PORT=4000
